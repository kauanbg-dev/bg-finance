# PostgreSQL (Neon)
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# Assinatura dos tokens de login (texto longo e aleatorio)
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

PORT=3000

# Endereco publico do app, usado no link de "esqueci a senha"
APP_URL=http://localhost:3000

# Envio de e-mail: use Brevo (https://brevo.com, funciona com remetente Gmail verificado)
# ou Resend (https://resend.com, precisa de dominio). Sem chave, o link aparece no log do servidor.
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM=BG Finance <seuemail@gmail.com>

# Bot do Telegram, criado no @BotFather. Sem o token, o app segue normal e o bot fica desligado.
# APP_URL precisa ser https para o Telegram conseguir falar com o servidor.
TELEGRAM_BOT_TOKEN=

# Chat que recebe o aviso de cada login. Mande /id para o bot e cole o numero aqui.
# So esse chat ve quem entrou. Sem o valor, o aviso fica desligado.
ADMIN_TELEGRAM_CHAT_ID=

# Login com Google (Google Cloud Console > APIs e servicos > Credenciais > ID do cliente OAuth, tipo "Aplicativo da Web").
# URI de redirecionamento autorizado: <APP_URL>/auth/google/callback. Sem os dois valores, o botao do Google some.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Senha do endereco que dispara os lembretes diarios de contas a vencer.
# Use o mesmo valor no secret CRON_SECRET do GitHub (Settings > Secrets and variables > Actions).
CRON_SECRET=
