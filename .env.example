# PostgreSQL (Neon)
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# Assinatura dos tokens de login (texto longo e aleatorio)
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

PORT=3000

# Endereco publico do app, usado no link de "esqueci a senha"
APP_URL=http://localhost:3000

# Envio de e-mail: use Brevo (https://brevo.com, funciona com remetente Gmail verificado)
# ou Resend (https://resend.com, precisa de dominio). Sem chave, o link aparece no log do servidor.
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM=BG Finance <seuemail@gmail.com>
